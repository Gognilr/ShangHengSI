{
	default_sni {$SITE_ADDRESS:localhost}
	skip_install_trust
	import /etc/caddy/fragments/{$CADDY_CA_MODE:development}.global
}

# 只有下载页走 HTTP，其余请求继续跳转 HTTPS。
http://{$SITE_ADDRESS:localhost} {
	handle /cert {
		redir /cert/ 308
	}
	handle /cert/shangheng-si-root.crt {
		rewrite * /root.crt
		root * /run/site-ca
		header Content-Disposition "attachment; filename=shangheng-si-root.crt"
		file_server
	}
	handle /cert/ {
		rewrite * /index.html
		root * /etc/caddy/fragments/public
		file_server
	}
	handle /cert/* {
		respond "页面不存在" 404
	}
	handle {
		redir https://{$SITE_ADDRESS:localhost}{uri} 308
	}
}

# 开发默认 localhost；安装脚本准备固定私网 IP 的自定义 CA。
{$SITE_ADDRESS:localhost} {
	import /etc/caddy/fragments/{$CADDY_CA_MODE:development}.tls

	# /api 转发给 app；上传大小限制 320 MB（SPEC 20.2）
	@audio_upload path_regexp audio_upload ^/api/v1/assistant/sessions/[^/]+/files$
	handle @audio_upload {
		request_body {
			max_size {$MAX_AUDIO_BODY_MB:520}MB
		}
		reverse_proxy app:8000
	}
	handle /api/* {
		request_body {
			max_size 320MB
		}
		reverse_proxy app:8000
	}

	# 前端静态文件（frontend/Dockerfile 构建进镜像的 /srv/frontend）；单页应用，找不到的路径回到 index.html
	handle {
		@manifest path *.webmanifest
		# /assets/ 下全是带哈希的构建产物，可长期缓存；index.html 不缓存（V31-U1 2.4）
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header @manifest Content-Type application/manifest+json
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
