{
	default_sni {$SITE_ADDRESS:localhost}
}

# 站点地址来自 SITE_ADDRESS（内网域名，如 review.公司域名）；开发环境默认 localhost。
# tls internal：用 Caddy 内部 CA 签发证书。有公司证书时改为
#   tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key
{$SITE_ADDRESS:localhost} {
	tls internal

	# /api 转发给 app；上传大小限制 320 MB（SPEC 20.2）
	handle /api/* {
		request_body {
			max_size 320MB
		}
		reverse_proxy app:8000
	}

	# 前端静态文件（frontend/Dockerfile 构建进镜像的 /srv/frontend）；单页应用，找不到的路径回到 index.html
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
