# install.sh 会自动生成 .env；开发时可复制后修改。.env 和 secrets/ 不进代码仓库。

# 数据库密码（必填，生产环境用随机长密码）
POSTGRES_PASSWORD=

# 系统版本号，同时作为后端镜像标签
APP_VERSION=dev

# 对外访问的内网域名；开发环境用 localhost
SITE_ADDRESS=localhost

# 宿主机上的监听端口（生产环境用 80 / 443）
HTTP_PORT=80
HTTPS_PORT=443

# 备份目录（生产数据盘 /data；开发时可改为 ./backup）。
# 目录属主需为容器内用户 uid 10001，否则 worker 无法写入。
BACKUP_HOST_DIR=/data/apps/aireview/backup

# worker 审核、解析并发（各 1～32，维护固定 1）；单文件上传上限（MB）
WORKER_REVIEW_CONCURRENCY=8
WORKER_PARSE_CONCURRENCY=2
MAX_UPLOAD_MB=30

# 密钥文件放在 deploy/secrets/（权限 600，属主 uid 10001，不进仓库）：
#   master_key       主密钥，32 字节随机值
#   backup_password  备份密码
